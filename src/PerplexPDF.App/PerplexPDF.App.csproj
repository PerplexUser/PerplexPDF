<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>PerplexPDF</AssemblyName>
    <RootNamespace>PerplexPDF.App</RootNamespace>
    <StartupObject>PerplexPDF.App.Startup</StartupObject>
    <PublishTrimmed>false</PublishTrimmed>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources/PerplexPDF.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../PerplexPDF.Application/PerplexPDF.Application.csproj" />
    <ProjectReference Include="../PerplexPDF.Infrastructure.Pdf/PerplexPDF.Infrastructure.Pdf.csproj" />
    <ProjectReference Include="../PerplexPDF.Infrastructure.Ocr/PerplexPDF.Infrastructure.Ocr.csproj" />
    <ProjectReference Include="../PerplexPDF.Infrastructure.Store/PerplexPDF.Infrastructure.Store.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Keep the English fallback in the same assembly as the compiled WPF resources. -->
    <EmbeddedResource Update="Resources/Strings.en-US.resx" WithCulture="false" ManifestResourceName="$(RootNamespace).Resources.Strings" />
    <Resource Include="Resources/PerplexPDF.ico" />
    <Content Include="../../assets/fonts/*.ttf" Link="assets/fonts/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../THIRD_PARTY_NOTICES.txt" Link="THIRD_PARTY_NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
