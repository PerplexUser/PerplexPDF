<Window x:Class="PerplexPDF.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:PerplexPDF.App"
        xmlns:app="clr-namespace:PerplexPDF.Application;assembly=PerplexPDF.Application"
        Title="PerplexPDF" Icon="Resources/PerplexPDF.ico" Width="1280" Height="820" MinWidth="780" MinHeight="450"
        WindowStartupLocation="CenterScreen" AllowDrop="True" DragOver="FilesDragOver" Drop="FilesDrop"
        Loaded="Start" Closing="WindowClosing">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
    <DataTemplate x:Key="OverlayTextEditor">
      <StackPanel>
        <Label Content="{ui:L Text}" Target="{Binding ElementName=OverlayTextEntry}" Padding="0,0,0,3"/>
        <TextBox x:Name="OverlayTextEntry" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" MinHeight="68"
                 MaxHeight="125" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxLength="4000"/>
        <Grid Margin="0,6,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel>
            <Label Content="{ui:L Font}" Target="{Binding ElementName=FontBox}" Padding="0,0,0,3"/>
            <ComboBox x:Name="FontBox" ItemsSource="{Binding Fonts}" SelectedItem="{Binding FontName, Mode=TwoWay}"
                      IsTextSearchEnabled="True" MaxDropDownHeight="300" VirtualizingPanel.IsVirtualizing="True"
                      VerticalContentAlignment="Center">
              <ComboBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ComboBox.ItemsPanel>
            </ComboBox>
          </StackPanel>
          <StackPanel Grid.Column="2" MinWidth="76">
            <Label Content="{ui:L FontSize}" Target="{Binding ElementName=SizeBox}" Padding="0,0,0,3"/>
            <TextBox x:Name="SizeBox" Text="{Binding FontSize, UpdateSourceTrigger=PropertyChanged}" MaxLength="12"/>
          </StackPanel>
        </Grid>
        <WrapPanel Margin="0,8,0,0">
          <CheckBox Content="{ui:L Bold}" FontWeight="Bold" IsChecked="{Binding Bold}" Margin="0,0,9,5"/>
          <CheckBox Content="{ui:L Italic}" FontStyle="Italic" IsChecked="{Binding Italic}" Margin="0,0,9,5"/>
          <CheckBox IsChecked="{Binding Underlined}" AutomationProperties.Name="{ui:L Underline}" Margin="0,0,0,5">
            <TextBlock Text="{ui:L Underline}" TextDecorations="Underline"/>
          </CheckBox>
        </WrapPanel>
        <Label Content="{ui:L Color}" Target="{Binding ElementName=TextColorBox}" Padding="0,5,0,3"/>
        <DockPanel>
          <Button DockPanel.Dock="Right" Style="{StaticResource Action}" Margin="6,0,0,0" Click="PickOverlayColor"
                  AutomationProperties.Name="{ui:L ChooseColor}">
            <StackPanel Orientation="Horizontal">
              <Border Width="15" Height="15" Margin="0,0,5,0" BorderThickness="1"
                      BorderBrush="{StaticResource RuleBrush}" Background="{Binding Color}"/>
              <TextBlock Text="{ui:L ChooseColor}"/>
            </StackPanel>
          </Button>
          <TextBox x:Name="TextColorBox" Text="{Binding Color, UpdateSourceTrigger=PropertyChanged}" MaxLength="9"/>
        </DockPanel>
      </StackPanel>
    </DataTemplate>
    <HierarchicalDataTemplate DataType="{x:Type app:PdfBookmark}" ItemsSource="{Binding Children}">
      <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" MaxWidth="180" ToolTip="{Binding Title}"/>
    </HierarchicalDataTemplate>
  </Window.Resources>
  <Window.InputBindings>
    <KeyBinding Key="O" Modifiers="Control" Command="{Binding Commands[OpenPdf]}"/>
    <KeyBinding Key="O" Modifiers="Control+Shift" Command="{Binding Commands[OpenProject]}"/>
    <KeyBinding Key="S" Modifiers="Control" Command="{Binding Commands[SaveProject]}"/>
    <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding Commands[SavePdf]}"/>
    <KeyBinding Key="F" Modifiers="Control" Command="{Binding Commands[Find]}"/>
    <KeyBinding Key="P" Modifiers="Control" Command="{Binding Commands[Print]}"/>
    <KeyBinding Key="Z" Modifiers="Control" Command="{Binding Commands[Undo]}"/>
    <KeyBinding Key="Y" Modifiers="Control" Command="{Binding Commands[Redo]}"/>
    <KeyBinding Key="OemPlus" Modifiers="Control" Command="{Binding Commands[ZoomIn]}"/>
    <KeyBinding Key="OemPlus" Modifiers="Control+Shift" Command="{Binding Commands[ZoomIn]}"/>
    <KeyBinding Key="OemMinus" Modifiers="Control" Command="{Binding Commands[ZoomOut]}"/>
    <KeyBinding Key="Add" Modifiers="Control" Command="{Binding Commands[ZoomIn]}"/>
    <KeyBinding Key="Subtract" Modifiers="Control" Command="{Binding Commands[ZoomOut]}"/>
    <KeyBinding Key="Escape" Command="{Binding Commands[Cancel]}"/>
  </Window.InputBindings>

  <DockPanel LastChildFill="True">
    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,0,0,1">
      <DockPanel Margin="14,7">
        <StackPanel Orientation="Horizontal" Margin="0,0,19,0">
          <Image Source="{StaticResource PerplexPDFLogo}" Width="24" Height="24" Stretch="Uniform"
                 VerticalAlignment="Center" Margin="0,0,8,0" SnapsToDevicePixels="True"/>
          <TextBlock Text="PerplexPDF" VerticalAlignment="Center" FontSize="19" FontWeight="SemiBold"/>
        </StackPanel>
        <Menu Background="Transparent" VerticalAlignment="Center" FontSize="13">
          <MenuItem Header="{ui:L File}">
            <MenuItem Header="{ui:L OpenPdfDialog}" InputGestureText="Ctrl+O" Command="{Binding Commands[OpenPdf]}"/>
            <MenuItem Header="{ui:L OpenProjectDialog}" InputGestureText="Ctrl+Shift+O" Command="{Binding Commands[OpenProject]}"/>
            <Separator/>
            <MenuItem Header="{ui:L SavePdfAs}" InputGestureText="Ctrl+Shift+S" Command="{Binding Commands[SavePdf]}"/>
            <MenuItem Header="{ui:L SaveProject}" InputGestureText="Ctrl+S" Command="{Binding Commands[SaveProject]}"/>
            <MenuItem Header="{ui:L SaveProjectAs}" Command="{Binding Commands[SaveProjectAs]}"/>
            <Separator/>
            <MenuItem Header="{ui:L ExportWord}" Command="{Binding Commands[ExportWord]}"/>
            <MenuItem Header="{ui:L ExportEpub}" Command="{Binding Commands[ExportEpub]}"/>
            <MenuItem Header="{ui:L ExportPng}" Command="{Binding Commands[Png]}"/>
            <MenuItem Header="{ui:L Print}" InputGestureText="Ctrl+P" Command="{Binding Commands[Print]}"/>
            <Separator/>
            <MenuItem Header="{ui:L CloseTab}" Command="{Binding Commands[Close]}"/>
            <MenuItem Header="{ui:L Exit}" Command="{Binding Commands[Exit]}"/>
          </MenuItem>
          <MenuItem Header="{ui:L Edit}">
            <MenuItem Header="{ui:L Undo}" InputGestureText="Ctrl+Z" Command="{Binding Commands[Undo]}"/>
            <MenuItem Header="{ui:L Redo}" InputGestureText="Ctrl+Y" Command="{Binding Commands[Redo]}"/>
            <MenuItem Header="{ui:L Find}" InputGestureText="Ctrl+F" Command="{Binding Commands[Find]}"/>
            <MenuItem Header="{ui:L CopyText}" InputGestureText="Ctrl+C" Command="{Binding Commands[Copy]}"/>
            <Separator/>
            <MenuItem Header="{ui:L AddText}" Command="{Binding Commands[Text]}"/>
            <MenuItem Header="{ui:L EditPdfText}" Command="{Binding Commands[EditPdfText]}"/>
            <MenuItem Header="{ui:L AddImage}" Command="{Binding Commands[Image]}"/>
          </MenuItem>
          <MenuItem Header="{ui:L View}">
            <MenuItem Header="{ui:L ZoomIn}" InputGestureText="Ctrl++" Command="{Binding Commands[ZoomIn]}"/>
            <MenuItem Header="{ui:L ZoomOut}" InputGestureText="Ctrl+-" Command="{Binding Commands[ZoomOut]}"/>
            <MenuItem Header="{ui:L FitWidth}" Command="{Binding Commands[FitWidth]}"/>
            <MenuItem Header="{ui:L FitPage}" Command="{Binding Commands[FitPage]}"/>
            <MenuItem Header="{ui:L ActualSize}" Command="{Binding Commands[ActualSize]}"/>
            <Separator/>
            <MenuItem Header="{ui:L SinglePage}" Command="{Binding Commands[Single]}"/>
            <MenuItem Header="{ui:L Continuous}" Command="{Binding Commands[Continuous]}"/>
            <MenuItem Header="{ui:L ShowThumbnails}" Command="{Binding Commands[Thumbnails]}"/>
            <MenuItem Header="{ui:L ShowBookmarks}" Command="{Binding Commands[Bookmarks]}"/>
          </MenuItem>
          <MenuItem Header="{ui:L Pages}">
            <MenuItem Header="{ui:L RotateRight}" Command="{Binding Commands[RotateRight]}"/>
            <MenuItem Header="{ui:L RotateLeft}" Command="{Binding Commands[RotateLeft]}"/>
            <MenuItem Header="{ui:L MoveUp}" Command="{Binding Commands[MoveUp]}"/>
            <MenuItem Header="{ui:L MoveDown}" Command="{Binding Commands[MoveDown]}"/>
            <MenuItem Header="{ui:L DeletePage}" Command="{Binding Commands[DeletePage]}"/>
            <MenuItem Header="{ui:L DuplicatePage}" Command="{Binding Commands[DuplicatePage]}"/>
            <Separator/>
            <MenuItem Header="{ui:L Extract}" Command="{Binding Commands[Extract]}"/>
            <MenuItem Header="{ui:L Merge}" Command="{Binding Commands[Merge]}"/>
            <MenuItem Header="{ui:L Split}" Command="{Binding Commands[Split]}"/>
          </MenuItem>
          <MenuItem Header="{ui:L Annotate}">
            <MenuItem Header="{ui:L Select}" InputGestureText="Esc" Command="{Binding Commands[Select]}"/>
            <MenuItem Header="{ui:L Highlight}" Command="{Binding Commands[Highlight]}"/>
            <MenuItem Header="{ui:L Underline}" Command="{Binding Commands[Underline]}"/>
            <MenuItem Header="{ui:L Note}" Command="{Binding Commands[Note]}"/>
            <MenuItem Header="{ui:L Rectangle}" Command="{Binding Commands[Rectangle]}"/>
            <MenuItem Header="{ui:L Ellipse}" Command="{Binding Commands[Ellipse]}"/>
            <MenuItem Header="{ui:L DeleteOverlay}" Command="{Binding Commands[DeleteOverlay]}"/>
          </MenuItem>
          <MenuItem Header="{ui:L Sign}">
            <MenuItem Header="{ui:L AddSignatureImage}" Command="{Binding Commands[SignatureImage]}"/>
          </MenuItem>
          <MenuItem Header="{ui:L Tools}">
            <MenuItem Header="{ui:L OcrDialog}" Command="{Binding Commands[Ocr]}"
                      ToolTip="{Binding OcrToolTip, RelativeSource={RelativeSource AncestorType=Window}}" ToolTipService.ShowOnDisabled="True"/>
            <MenuItem Header="{ui:L CreateImages}" Command="{Binding Commands[Images]}"/>
            <MenuItem Header="{ui:L Settings}" Command="{Binding Commands[Settings]}"/>
            <MenuItem Header="{ui:L DocumentInfo}" Command="{Binding Commands[DocumentInfo]}"/>
          </MenuItem>
          <MenuItem Header="{ui:L Help}">
            <MenuItem Header="{ui:L QuickGuide}" Command="{Binding Commands[Help]}"/>
            <MenuItem Header="{ui:L Notices}" Command="{Binding Commands[Notices]}"/>
            <Separator/>
            <MenuItem Header="{ui:L About}" Command="{Binding Commands[About]}"/>
          </MenuItem>
        </Menu>
      </DockPanel>
    </Border>

    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,0,0,1">
      <WrapPanel Margin="14,8,14,8" Orientation="Horizontal">
        <Button Style="{StaticResource Primary}" Content="{ui:L Open}" ToolTip="{ui:L OpenPdfDialog}" Command="{Binding Commands[OpenPdf]}"/>
        <Button Style="{StaticResource Action}" Content="{ui:L SavePdf}" ToolTip="{ui:L SavePdfAs}" Command="{Binding Commands[SavePdf]}"/>
        <Button Style="{StaticResource Action}" Content="{ui:L SaveProject}" ToolTip="{ui:L SaveProjectAs}" Command="{Binding Commands[SaveProject]}"/>
        <Border Width="1" Background="{StaticResource RuleBrush}" Margin="6,3,11,3"/>
        <Button Style="{StaticResource Action}" Content="↶" ToolTip="{ui:L Undo}" AutomationProperties.Name="{ui:L Undo}" Command="{Binding Commands[Undo]}"/>
        <Button Style="{StaticResource Action}" Content="↷" ToolTip="{ui:L Redo}" AutomationProperties.Name="{ui:L Redo}" Command="{Binding Commands[Redo]}"/>
        <Button Style="{StaticResource Action}" Content="{ui:L Find}" ToolTip="{ui:L Find}" Command="{Binding Commands[Find]}"/>
        <Border Width="1" Background="{StaticResource RuleBrush}" Margin="6,3,11,3"/>
        <Button Style="{StaticResource Action}" Content="{ui:L AddText}" ToolTip="{ui:L AddText}" Command="{Binding Commands[Text]}"/>
        <Button Style="{StaticResource Action}" Content="{ui:L EditTextButton}" ToolTip="{ui:L EditPdfText}" Command="{Binding Commands[EditPdfText]}"/>
        <Button Style="{StaticResource Action}" Content="{ui:L AddImage}" ToolTip="{ui:L AddImage}" Command="{Binding Commands[Image]}"/>
        <Button Style="{StaticResource Action}" Content="{ui:L Highlight}" ToolTip="{ui:L Highlight}" Command="{Binding Commands[Highlight]}"/>
        <Button Style="{StaticResource Action}" Content="{ui:L Note}" ToolTip="{ui:L Note}" Command="{Binding Commands[Note]}"/>
        <Button Style="{StaticResource Action}" Content="OCR" ToolTip="{Binding OcrToolTip, RelativeSource={RelativeSource AncestorType=Window}}"
                ToolTipService.ShowOnDisabled="True" Command="{Binding Commands[Ocr]}"/>
        <Border Width="1" Background="{StaticResource RuleBrush}" Margin="6,3,11,3"/>
        <Button Style="{StaticResource Action}" Content="{ui:L ExportWordButton}" ToolTip="{ui:L ExportWord}" Command="{Binding Commands[ExportWord]}"/>
        <Button Style="{StaticResource Action}" Content="{ui:L ExportEpubButton}" ToolTip="{ui:L ExportEpub}" Command="{Binding Commands[ExportEpub]}"/>
      </WrapPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,1,0,0">
      <Grid Margin="14,6">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <DockPanel LastChildFill="True" Margin="0,0,10,0">
          <Ellipse DockPanel.Dock="Left" Width="7" Height="7" Fill="#15865E" Margin="0,0,7,0"/>
          <TextBlock DockPanel.Dock="Left" Text="{ui:L LocalStatus}" FontWeight="SemiBold" Margin="0,0,14,0"/>
          <TextBlock DockPanel.Dock="Left" Text="{Binding Active.PageStatus}" Margin="0,0,14,0"/>
          <TextBlock DockPanel.Dock="Left" Text="{Binding Active.ZoomStatus}" Margin="0,0,14,0"/>
          <TextBlock DockPanel.Dock="Left" Text="{Binding Active.ChangeStatus}" Margin="0,0,14,0"/>
          <TextBlock Text="{Binding Status}" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"
                     AutomationProperties.LiveSetting="Polite"/>
        </DockPanel>
        <ui:CopyrightLink Grid.Column="1"/>
      </Grid>
    </Border>

    <Border DockPanel.Dock="Top" Visibility="{Binding Busy, Converter={StaticResource BoolVisibility}}"
            Background="{StaticResource AccentTintBrush}" Padding="14,5">
      <DockPanel>
        <Button DockPanel.Dock="Right" Style="{StaticResource Action}" Content="{ui:L Cancel}" Command="{Binding Commands[Cancel]}"/>
        <TextBlock VerticalAlignment="Center" Text="{Binding Progress}" AutomationProperties.LiveSetting="Polite"/>
      </DockPanel>
    </Border>

    <Grid Background="{StaticResource WorkspaceBrush}">
      <Grid x:Name="WorkspaceGrid" Visibility="{Binding HasDocument, Converter={StaticResource BoolVisibility}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="208"/><ColumnDefinition Width="*"/><ColumnDefinition Width="250"/>
        </Grid.ColumnDefinitions>

        <DockPanel Background="{StaticResource PanelBrush}" Grid.Column="0">
          <TextBlock DockPanel.Dock="Top" Text="{ui:L Navigator}" Style="{StaticResource SectionLabel}" Margin="13,12,0,8"/>
          <TabControl x:Name="NavigatorTabs" Background="Transparent" BorderThickness="0" Padding="0">
            <TabItem Header="{ui:L Thumbnails}">
              <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,4">
                  <Button Style="{StaticResource Action}" Content="↑" ToolTip="{ui:L MoveUp}" AutomationProperties.Name="{ui:L MoveUp}" Command="{Binding Commands[MoveUp]}"/>
                  <Button Style="{StaticResource Action}" Content="↓" ToolTip="{ui:L MoveDown}" AutomationProperties.Name="{ui:L MoveDown}" Command="{Binding Commands[MoveDown]}"/>
                  <Button Style="{StaticResource Action}" Content="↻" ToolTip="{ui:L RotateRight}" AutomationProperties.Name="{ui:L RotateRight}" Command="{Binding Commands[RotateRight]}"/>
                </StackPanel>
                <ListBox x:Name="Thumbnails" ItemsSource="{Binding Active.Pages}" SelectedItem="{Binding Active.Current, Mode=OneWay}"
                         SelectionChanged="ThumbnailSelected" Background="Transparent" BorderThickness="0"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True"
                         PreviewMouseLeftButtonDown="ThumbnailMouseDown" PreviewMouseMove="ThumbnailMouseMove"
                         AllowDrop="True" DragOver="ThumbnailDragOver" Drop="ThumbnailDrop"
                         AutomationProperties.Name="{ui:L Thumbnails}">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <StackPanel HorizontalAlignment="Center" Margin="6,8">
                        <Border Background="White" Padding="1" BorderBrush="{StaticResource RuleBrush}" BorderThickness="1">
                          <ui:ThumbnailImage Width="120" Height="121" Stretch="Uniform" AutomationProperties.Name="{Binding Label}"/>
                        </Border>
                        <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </DockPanel>
            </TabItem>
            <TabItem Header="{ui:L Bookmarks}">
              <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="6,5">
                  <Label Content="{ui:L FilterBookmarks}" Target="{Binding ElementName=BookmarkSearch}" Padding="0,0,0,3"/>
                  <TextBox x:Name="BookmarkSearch" Text="{Binding Active.BookmarkQuery, UpdateSourceTrigger=PropertyChanged}"
                           MaxLength="256" AutomationProperties.Name="{ui:L FilterBookmarks}"/>
                </StackPanel>
                <TreeView x:Name="BookmarkTree" ItemsSource="{Binding Active.Bookmarks}" BorderThickness="0"
                          Background="Transparent" SelectedItemChanged="BookmarkSelected" AutomationProperties.Name="{ui:L Bookmarks}">
                  <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding DataContext.Active.FilteringBookmarks, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                          <Setter Property="IsExpanded" Value="True"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TreeView.ItemContainerStyle>
                </TreeView>
              </DockPanel>
            </TabItem>
          </TabControl>
        </DockPanel>

        <DockPanel Grid.Column="1" Background="{StaticResource WorkspaceBrush}">
          <ListBox x:Name="TabStrip" DockPanel.Dock="Top" BorderThickness="0,0,0,1" BorderBrush="{StaticResource RuleBrush}"
                   Background="{StaticResource SurfaceBrush}" Padding="4,4,4,0" ItemsSource="{Binding Tabs}"
                   SelectedItem="{Binding Active, Mode=TwoWay}" SelectionChanged="TabSelected"
                   ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                   AutomationProperties.Name="{ui:L Documents}">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" Margin="8,5,3,5">
                  <TextBlock Text="{Binding Title}" ToolTip="{Binding Name}" MaxWidth="200" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                  <Button Content="×" Margin="8,0,0,0" Padding="3,0" Background="Transparent" BorderThickness="0"
                          ToolTip="{ui:L CloseTab}" AutomationProperties.Name="{ui:L CloseTab}" Click="CloseTabClick"/>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <Border DockPanel.Dock="Top" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,0,0,1">
            <WrapPanel Margin="10,6">
              <Button Style="{StaticResource Action}" Content="‹" ToolTip="{ui:L PreviousPage}" AutomationProperties.Name="{ui:L PreviousPage}" Command="{Binding Commands[Previous]}"/>
              <TextBox x:Name="PageNumberBox" Width="38" Text="{Binding Active.Current.Number, Mode=OneWay}"
                       AutomationProperties.Name="{ui:L PageInput}" KeyDown="PageNumberKeyDown" Margin="0,0,4,0"/>
              <Button Style="{StaticResource Action}" Content="›" ToolTip="{ui:L NextPage}" AutomationProperties.Name="{ui:L NextPage}" Command="{Binding Commands[Next]}"/>
              <Border Width="1" Margin="3,0,8,0" Background="{StaticResource RuleBrush}"/>
              <Button Style="{StaticResource Action}" Content="−" ToolTip="{ui:L ZoomOut}" AutomationProperties.Name="{ui:L ZoomOut}" Command="{Binding Commands[ZoomOut]}"/>
              <TextBlock Text="{Binding Active.ZoomStatus}" Width="49" TextAlignment="Center" VerticalAlignment="Center"/>
              <Button Style="{StaticResource Action}" Content="+" ToolTip="{ui:L ZoomIn}" AutomationProperties.Name="{ui:L ZoomIn}" Command="{Binding Commands[ZoomIn]}"/>
              <Button Style="{StaticResource Action}" Content="{ui:L FitPage}" ToolTip="{ui:L FitPage}" Command="{Binding Commands[FitPage]}"/>
              <Button Style="{StaticResource Action}" Content="{ui:L FitWidth}" ToolTip="{ui:L FitWidth}" Command="{Binding Commands[FitWidth]}"/>
              <TextBlock Text="{Binding Active.ToolLabel}" VerticalAlignment="Center" FontWeight="SemiBold"
                         Foreground="{StaticResource AccentBrush}" Margin="7,0,0,0"/>
            </WrapPanel>
          </Border>

          <Border x:Name="SearchBar" Visibility="Collapsed" DockPanel.Dock="Top" Background="{StaticResource AccentTintBrush}" Padding="10,5">
            <WrapPanel>
              <TextBox x:Name="SearchBox" Width="185" MaxLength="256" Text="{Binding Active.SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                       AutomationProperties.Name="{ui:L Find}" KeyDown="SearchKeyDown" Margin="0,0,5,0"/>
              <Button Style="{StaticResource Action}" Content="{ui:L Find}" Command="{Binding Commands[Search]}"/>
              <Button Style="{StaticResource Action}" Content="‹" ToolTip="{ui:L PreviousMatch}" AutomationProperties.Name="{ui:L PreviousMatch}" Command="{Binding Commands[PreviousMatch]}"/>
              <Button Style="{StaticResource Action}" Content="›" ToolTip="{ui:L NextMatch}" AutomationProperties.Name="{ui:L NextMatch}" Command="{Binding Commands[NextMatch]}"/>
              <TextBlock Text="{Binding Active.SearchStatus}" VerticalAlignment="Center" Margin="6,0"/>
              <Button Style="{StaticResource Action}" Content="×" ToolTip="{ui:L CloseSearch}" AutomationProperties.Name="{ui:L CloseSearch}" Command="{Binding Commands[CloseSearch]}"/>
            </WrapPanel>
          </Border>

          <ListBox x:Name="Viewer" ItemsSource="{Binding Active.ViewerPages}" Background="Transparent" BorderThickness="0"
                   ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                   VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                   VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.CacheLength="0"
                   ScrollViewer.ScrollChanged="ViewerScrolled" PreviewMouseWheel="ViewerWheel"
                   AutomationProperties.Name="{ui:L DocumentViewer}">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                      <Border Padding="22,14" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center"/>
                      </Border>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="#C1CEDF" BorderThickness="1" Background="White">
                  <ui:PageSurface AutomationProperties.Name="{Binding Label}"/>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>

        <DockPanel Grid.Column="2" Background="{StaticResource PanelBrush}">
          <TextBlock DockPanel.Dock="Top" Text="{ui:L Inspector}" Style="{StaticResource SectionLabel}" Margin="13,12,0,8"/>
          <TabControl x:Name="InspectorTabs" BorderThickness="0" Padding="0" Background="Transparent">
            <TabItem Header="{ui:L Properties}">
              <Grid>
                <TextBlock Margin="13,16" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Text="{ui:L SelectOverlayHint}"/>
                <ContentControl Content="{Binding Active.Inspector}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                  <ContentControl.Style>
                    <Style TargetType="ContentControl">
                      <Style.Triggers>
                        <Trigger Property="Content" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></Trigger>
                      </Style.Triggers>
                    </Style>
                  </ContentControl.Style>
                  <ContentControl.ContentTemplate>
                    <DataTemplate>
                      <DockPanel Background="{StaticResource PanelBrush}">
                        <WrapPanel DockPanel.Dock="Bottom" Margin="13,8,13,13">
                          <Button Style="{StaticResource Primary}" Content="{ui:L Apply}"
                                  Command="{Binding DataContext.Commands[ApplyOverlay], RelativeSource={RelativeSource AncestorType=Window}}"/>
                          <Button Style="{StaticResource Action}" Content="{ui:L Delete}"
                                  Command="{Binding DataContext.Commands[DeleteOverlay], RelativeSource={RelativeSource AncestorType=Window}}"/>
                        </WrapPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                          <StackPanel Margin="13,14">
                            <TextBlock Text="{Binding Kind}" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8"/>
                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource OverlayTextEditor}"
                                              Visibility="{Binding IsText, Converter={StaticResource BoolVisibility}}"/>
                            <TextBlock Text="{ui:L CoordinatesHint}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,11,0,9"/>
                            <UniformGrid Columns="2">
                              <StackPanel Margin="0,0,5,4">
                                <Label Content="X" Target="{Binding ElementName=XBox}" Padding="0,0,0,3"/>
                                <TextBox x:Name="XBox" Text="{Binding X, UpdateSourceTrigger=PropertyChanged}"/>
                              </StackPanel>
                              <StackPanel Margin="0,0,0,4">
                                <Label Content="Y" Target="{Binding ElementName=YBox}" Padding="0,0,0,3"/>
                                <TextBox x:Name="YBox" Text="{Binding Y, UpdateSourceTrigger=PropertyChanged}"/>
                              </StackPanel>
                              <StackPanel Margin="0,0,5,4">
                                <Label Content="{ui:L Width}" Target="{Binding ElementName=WBox}" Padding="0,0,0,3"/>
                                <TextBox x:Name="WBox" Text="{Binding Width, UpdateSourceTrigger=PropertyChanged}"/>
                              </StackPanel>
                              <StackPanel Margin="0,0,0,4">
                                <Label Content="{ui:L Height}" Target="{Binding ElementName=HBox}" Padding="0,0,0,3"/>
                                <TextBox x:Name="HBox" Text="{Binding Height, UpdateSourceTrigger=PropertyChanged}"/>
                              </StackPanel>
                            </UniformGrid>
                            <StackPanel Visibility="{Binding HasShapeColor, Converter={StaticResource BoolVisibility}}">
                              <Label Content="{ui:L Color}" Target="{Binding ElementName=ColorBox}" Padding="0,5,0,3"/>
                              <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource Action}" Margin="6,0,0,0"
                                        Content="{ui:L ChooseColor}" Click="PickOverlayColor"/>
                                <TextBox x:Name="ColorBox" Text="{Binding Color, UpdateSourceTrigger=PropertyChanged}" MaxLength="9"/>
                              </DockPanel>
                            </StackPanel>
                          </StackPanel>
                        </ScrollViewer>
                      </DockPanel>
                    </DataTemplate>
                  </ContentControl.ContentTemplate>
                </ContentControl>
              </Grid>
            </TabItem>
            <TabItem Header="{ui:L Comments}">
              <ListBox x:Name="Comments" ItemsSource="{Binding Active.Comments}" SelectionChanged="CommentSelected"
                       Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                  <DataTemplate><TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="5,7" MaxHeight="70"/></DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </TabItem>
          </TabControl>
        </DockPanel>
      </Grid>

      <Grid x:Name="EmptyWorkspace">
        <Grid.Style>
          <Style TargetType="Grid">
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers><DataTrigger Binding="{Binding HasDocument}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
          </Style>
        </Grid.Style>
        <Border Width="470" Padding="32,29" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="14"
                Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource RuleBrush}" BorderThickness="1">
          <StackPanel>
            <Border Background="{StaticResource AccentTintBrush}" CornerRadius="12" Width="55" Height="55" HorizontalAlignment="Left">
              <Path Stretch="Uniform" Margin="14" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.7"
                    Data="M 2,1 L 10,1 15,6 15,17 2,17 Z M 10,1 L 10,6 15,6 M 5,10 L 12,10 M 5,13 L 10,13"/>
            </Border>
            <TextBlock Text="{ui:L EmptyTitle}" FontSize="26" FontWeight="SemiBold" Margin="0,13,0,6"/>
            <TextBlock Text="{ui:L EmptyDescription}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="14"/>
            <StackPanel Orientation="Horizontal" Margin="0,19,0,0">
              <Button Style="{StaticResource Primary}" Content="{ui:L OpenPdf}" Command="{Binding Commands[OpenPdf]}"/>
              <Button Style="{StaticResource Action}" Content="{ui:L OpenProject}" Command="{Binding Commands[OpenProject]}"/>
            </StackPanel>
            <TextBlock Text="{ui:L DropHint}" Foreground="{StaticResource MutedBrush}" Margin="0,15,0,0"/>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
