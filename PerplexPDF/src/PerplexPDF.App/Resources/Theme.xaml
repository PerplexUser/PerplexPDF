      <DrawingGroup>
        <GeometryDrawing>
          <GeometryDrawing.Brush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
              <GradientStop Color="#2966DC" Offset="0"/>
              <GradientStop Color="#123984" Offset="1"/>
            </LinearGradientBrush>
          </GeometryDrawing.Brush>
          <GeometryDrawing.Geometry>
            <RectangleGeometry Rect="9,9,238,238" RadiusX="53" RadiusY="53"/>
          </GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing Brush="#59092655"
                         Geometry="M70,43 H146 L185,82 V191 A16,16 0 0 1 169,207 H70 A16,16 0 0 1 54,191 V59 A16,16 0 0 1 70,43 Z"/>
        <GeometryDrawing Brush="#F8FBFF"
                         Geometry="M66,36 H142 L181,75 V184 A16,16 0 0 1 165,200 H66 A16,16 0 0 1 50,184 V52 A16,16 0 0 1 66,36 Z"/>
        <GeometryDrawing Brush="#A5C6FF" Geometry="M142,36 V61 A14,14 0 0 0 156,75 H181 Z"/>
        <GeometryDrawing Geometry="M76,94 H133 M76,116 H124 M76,138 H102">
          <GeometryDrawing.Pen><Pen Brush="#4C77B3" Thickness="9" StartLineCap="Round" EndLineCap="Round"/></GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Geometry="M75,174 H108">
          <GeometryDrawing.Pen><Pen Brush="#A5C6FF" Thickness="7" StartLineCap="Round" EndLineCap="Round"/></GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Brush="#52E0C2"
                         Geometry="M118,169 L125,144 L185,84 A10,10 0 0 1 199,84 L207,92 A10,10 0 0 1 207,106 L147,166 L118,174 Z">
          <GeometryDrawing.Pen><Pen Brush="#123984" Thickness="7" LineJoin="Round"/></GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Geometry="M177,92 L199,114 M125,144 L147,166">
          <GeometryDrawing.Pen><Pen Brush="#123984" Thickness="6"/></GeometryDrawing.Pen>
        </GeometryDrawing>
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>
  <SolidColorBrush x:Key="InkBrush" Color="#172638"/>
  <SolidColorBrush x:Key="MutedBrush" Color="#52657B"/>
  <SolidColorBrush x:Key="AccentBrush" Color="#164DBD"/>
  <SolidColorBrush x:Key="AccentTintBrush" Color="#E9F1FF"/>
  <SolidColorBrush x:Key="RuleBrush" Color="#D8E2EF"/>
  <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="WorkspaceBrush" Color="#E5EBF4"/>
  <SolidColorBrush x:Key="PanelBrush" Color="#F7F9FD"/>
  <Style TargetType="Window">
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
  </Style>
  <Style x:Key="Action" TargetType="Button">
    <Setter Property="Padding" Value="11,6"/>
    <Setter Property="Margin" Value="0,0,5,0"/>
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource RuleBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Body" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="Opacity" Value=".82"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Body" Property="Opacity" Value=".65"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Body" Property="BorderBrush" Value="#1B74DB"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Body" Property="Opacity" Value=".4"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Action}">
    <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style TargetType="TextBox">
    <Setter Property="Padding" Value="7,4"/>
    <Setter Property="BorderBrush" Value="{StaticResource RuleBrush}"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style x:Key="SectionLabel" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
  </Style>
</ResourceDictionary>
