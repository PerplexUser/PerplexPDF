<UserControl x:Class="PerplexPDF.App.CopyrightLink"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <TextBlock FontSize="13" Foreground="{StaticResource MutedBrush}" TextWrapping="NoWrap">
    <Hyperlink x:Name="SiteLink" Foreground="{StaticResource AccentBrush}" NavigateUri="https://www.perplex.click/"
               RequestNavigate="OpenCopyright" AutomationProperties.Name="© by www.perplex.click">
      <Run x:Name="SiteCaption" Text="© by www.perplex.click"/>
    </Hyperlink>
  </TextBlock>
</UserControl>
